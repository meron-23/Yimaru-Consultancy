# ==============================================================================
# Yimaru Consulting AI CMS — Environment Configuration
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=replace-this-with-a-secure-random-secret-key-min-32-chars

# Supabase Configuration
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
# The Service Role Key is used ONLY by backend server and is NEVER sent to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Credentials
# Configure Gemini or OpenAI (or both). If omitted, the CMS operates in high-fidelity
# intelligent rule-based offline fallback mode with built-in Amharic, Oromo, and Tigrinya dictionaries.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Default Initial Administrator
ADMIN_EMAIL=admin@yimaru.com
ADMIN_PASSWORD=AdminYimaru2026!

# Yimaru CRM Integration (Firestore sync for student leads)
# Automatically forwards website assessment leads into Yimaru CRM
CRM_FIREBASE_API_KEY=AIzaSyCCegjxUhxz8n-ahDmDmmMiM9mNDZTdd7Y
CRM_FIREBASE_PROJECT_ID=yimaru-crm
CRM_SYNC_EMAIL=website-integration@yimaru.academy
CRM_SYNC_PASSWORD=YimaruIntegration2026!

